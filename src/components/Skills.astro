---
const groups = [
  { category: "programming & development", items: ["python", "sql", "javascript", "r", "git"] },
  { category: "data science, ai & analytics", items: ["tensorflow", "pytorch", "scikit-learn", "pandas", "tableau"] },
  { category: "data engineering & cloud", items: ["spark", "aws", "databricks"] },
];

const certifications = [
  "databricks certified data engineer associate (jan 2026)",
  "microsoft certified: azure fundamentals (oct 2026)",
];
---

<section id="skills" class="section-block">
  <div class="skills-groups">
    {groups.map((group) => (
      <p class="skills-group">
        <strong>{group.category}:</strong>
        {group.items.join(", ")}
      </p>
    ))}
    <p class="skills-group">
      <strong>certifications:</strong>
      {certifications.map((c) => (
        <>
          <br />
          {c}
        </>
      ))}
    </p>
  </div>
</section>
