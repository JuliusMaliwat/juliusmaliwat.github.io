---
// Top navigation: brand link back to home, plus links to each dedicated page.
// Always expanded, even on mobile, no hamburger, matching marmikpatel.com.
const links = [
  { label: "Experience", href: "/experience/" },
  { label: "Education", href: "/education/" },
  { label: "Skills", href: "/skills/" },
];

---

<header class="site-nav-shell">
  <nav class="site-nav" aria-label="Main">
    <a href="/" class="site-brand" aria-label="Homepage">
      <span class="brand-text">Julius Maliwat</span>
    </a>

    <div class="site-nav-links">
      {links.map((link) => (
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>
