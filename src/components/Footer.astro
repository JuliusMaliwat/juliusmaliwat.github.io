---
import { EMAIL, GITHUB_URL, LINKEDIN_URL } from "../consts";
---

<footer class="site-footer" aria-label="Contact links">
  <div class="site-footer-inner">
    <div class="site-footer-signature">
      <p class="site-footer-title">connect</p>
      <p class="muted">milan, italy</p>
    </div>

    <div class="site-footer-links">
      <a class="footer-link" href={`mailto:${EMAIL}`}>email</a>
      <a class="footer-link" href={GITHUB_URL} target="_blank" rel="noreferrer">github</a>
      <a class="footer-link" href={LINKEDIN_URL} target="_blank" rel="noreferrer">linkedin</a>
      <a class="footer-link" href="/cv.pdf" target="_blank" rel="noreferrer">cv</a>
    </div>
  </div>
</footer>
